# =============================================
# PriyoShop — Development .env
# =============================================
SECRET_KEY=dev-secret-key-priyoshop-change-in-production-2024
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Use SQLite for development (set False for PostgreSQL)
USE_SQLITE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=priyoshop_db
DB_USER=priyoshop_user
DB_PASSWORD=priyoshop_pass
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=dev@priyoshop.com
EMAIL_HOST_PASSWORD=dev_password
DEFAULT_FROM_EMAIL=PriyoShop <noreply@priyoshop.com>

MEDIA_ROOT=media
MEDIA_URL=/media/

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
TIMEZONE=Asia/Dhaka

SITE_NAME=PriyoShop
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_PIXEL_ID=
SENTRY_DSN=
