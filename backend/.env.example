# =============================================
# PriyoShop — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Core Django ---
SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=priyoshop_db
DB_USER=priyoshop_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- SQLite (development fallback only) ---
USE_SQLITE=False

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=PriyoShop <noreply@priyoshop.com>

# --- Media / Storage ---
MEDIA_ROOT=media
MEDIA_URL=/media/

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Currency & Locale ---
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
TIMEZONE=Asia/Dhaka

# --- Site ---
SITE_NAME=PriyoShop
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Tracking (also configurable from admin DB settings) ---
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_PIXEL_ID=

# --- Sentry (optional) ---
SENTRY_DSN=
